# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# OS
Thumbs.db
.DS_Store

# The patched Android stub jar is TRACKED (20MB, changes ~never) so a fresh clone / the Docker
# build compiles without PowerShell + the Android SDK. Regenerate with: start.bat android-jar.
/tmp-androidjar/

# The data/ dir is BOTH a Gradle module (build.gradle.kts — 4 modules depend on :data) AND, when
# the app is run from the repo root, a runtime data dir. Track the module file; ignore the runtime
# spew. (A fresh clone needs data/ to exist or the Gradle build fails: "project ':data' … does not exist".)
/data/build/
/data/downloads/
/data/extensions/
/data/logs/
/data/settings/
/data/covers/
/data/cache/
/data/bin/
/data/*.json
/data/.flare-probed
*.log

# Local env
local.properties

# Personal doc archives (local only)
docs/*.rar
